{
  "name": "@zanix/auth",
  "version": "1.0.0",
  "nodeModulesDir": "auto",
  "zanix": {
    "project": "library"
  },
  "links": [],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils@^4.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/path": "jsr:@std/path@0.224",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.16",
    "@zanix/server": "jsr:@zanix/server@^4.0.0",
    "@zanix/logger": "jsr:@zanix/utils@^4.0.0/logger",
    "@zanix/testing": "jsr:@zanix/utils@^4.0.0/testing",
    "@zanix/errors": "jsr:@zanix/utils@^4.0.0/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^4.0.0/helpers",
    "@zanix/validator": "jsr:@zanix/utils@^4.0.0/validator",
    "@zanix/types": "jsr:@zanix/utils@^4.0.0/types",
    "@zanix/datamaster/cache/types": "jsr:@zanix/datamaster@^1.9.0/cache/types",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "scopes": {
    "./src/@tests/": {
      "@zanix/datamaster": "jsr:@zanix/datamaster@^1.6.0",
      "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.6.0/core"
    }
  },
  "exports": {
    ".": "./mod.ts",
    "./core": "./src/modules/core.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}
