{
  "name": "@zanix/auth",
  "version": "0.8.1",
  "nodeModulesDir": "auto",
  "zanix": {
    "project": "library"
  },
  "links": [],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils@^4.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/path": "jsr:@std/path@0.224",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.16",
    "@zanix/server": "jsr:@zanix/server@^4.0.0",
    "@zanix/logger": "jsr:@zanix/utils@^4.0.0/logger",
    "@zanix/testing": "jsr:@zanix/utils@^4.0.0/testing",
    "@zanix/errors": "jsr:@zanix/utils@^4.0.0/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^4.0.0/helpers",
    "@zanix/validator": "jsr:@zanix/utils@^4.0.0/validator",
    "@zanix/types": "jsr:@zanix/utils@^4.0.0/types",
    "@zanix/datamaster/cache/types": "jsr:@zanix/datamaster@^1.7.0/cache/types",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  // `@zanix/datamaster` is a test-only dependency, not a production one: no file under `src/modules/`,
  // `src/utils/`, or `src/typings/` imports it — real code only ever documents the pattern parity with
  // `@zanix/datamaster`'s own `core.ts` loaders in a comment, never imports the package itself. Only
  // `src/@tests/functional/**` dynamically imports `@zanix/datamaster/core` to load a real cache
  // implementation for rate-limit/block-list/OTP assertions. A bare top-level `imports` entry for it
  // would be `nodeModulesDir: "auto"`-materialized (`mongoose`/`redis`/`@aws-sdk/*`) for every
  // `deno check`/`deno test` run against this repo regardless of that reachability — scoping it to the
  // test directory keeps this package's own dev footprint honest instead. Same pattern already used by
  // `@zanix/asyncmq` and `@zanix/app`'s own `deno.jsonc`. See `deno-lazy-dependency-pattern`.
  "scopes": {
    "./src/@tests/": {
      "@zanix/datamaster": "jsr:@zanix/datamaster@^1.6.0",
      "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.6.0/core"
    }
  },
  "exports": {
    ".": "./mod.ts",
    "./core": "./src/modules/core.ts"
  },
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}
